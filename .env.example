POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_EXTRA_MODELS=openai/gpt-oss-20b

EMBEDDINGS_URL=http://localhost:8080
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RAG_MIN_DENSE_SCORE=0.81

WEBHOOK_SECRET=change-me
DAILY_REQUEST_LIMIT=150
PROMPT_VERSION=v2

CACHE_TTL_SECONDS=3600
CACHE_HISTORY_TURNS=2
WEBHOOK_MAX_TRIES=3

CLIENT_RATE_LIMIT_PER_MINUTE=20
CLIENT_NEW_CONVERSATIONS_PER_HOUR=10
CLIENT_DAILY_MESSAGES_PER_IP=60
WORKER_METRICS_PORT=9101

MANAGER_TOKEN=demo-manager

# Демо: консоль менеджера входит без пароля (входа в неё нет намеренно), Swagger /docs включён.
# Только для локального запуска. Без DEMO_MODE=true консоль менеджера недоступна.
DEMO_MODE=true

# За обратным прокси: адрес прокси, которому uvicorn доверяет X-Forwarded-For (не '*'), иначе лимиты по IP общие.
# FORWARDED_ALLOW_IPS=
